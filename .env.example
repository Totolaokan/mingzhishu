# 复制为 .env 后填写。.env 只放在服务器上，不要提交到代码仓库，也不要放进 public/。
# 以下供应商与地址只是格式示例，项目尚未选定供应商。

# —— 服务 ——
HOST=127.0.0.1
PORT=8787
# 部署在反向代理之后时设为 1，以便按 X-Forwarded-For 限流
TRUST_PROXY=0

# —— 大模型（必填 4 项，缺一即为“未配置”状态）——
# openai_compatible：调用 {LLM_BASE_URL}/chat/completions
# anthropic：        调用 {LLM_BASE_URL}/v1/messages
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
# 显示在页面“发送前说明”里的服务名称；确定供应商后填写
LLM_VENDOR_LABEL=
LLM_TIMEOUT_MS=20000

# —— 语音转写（可选；不配置时语音入口显示“尚未接入”，文字输入不受影响）——
# 调用 {STT_BASE_URL}/audio/transcriptions（OpenAI 兼容 multipart 接口）
STT_BASE_URL=https://api.example.com/v1
STT_API_KEY=
STT_MODEL=
STT_VENDOR_LABEL=
STT_LANGUAGE=zh
STT_TIMEOUT_MS=30000

# —— 限制（可选，以下为默认值）——
MAX_INPUT_CHARS=1000
MAX_AUDIO_BYTES=4194304
MAX_RECORD_SECONDS=90
RATE_WINDOW_MS=600000
RATE_REVEAL_PER_WINDOW=8
RATE_TRANSCRIBE_PER_WINDOW=12
RATE_GLOBAL_REVEAL_PER_MINUTE=60
REVEAL_DEADLINE_MS=45000
